# Charger
/sys/class/oplus_chg/*  mmi_charging_enable    0660    system  system

# Torch control
/sys/devices/platform/soc/5c1c000.qcom,cci1/5c1c000.qcom,cci1:qcom,camera-flash@0 torch_brightness 0660 cameraserver camera


# NFC
/dev/pn553    0660    nfc               nfc

# Reserve
/dev/block/bootdevice/by-name/oplusreserve2    0660    root    system

# WiFi
firmware_directories /odm/etc/wifi/

# CPU and devfreq nodes for PowerHAL
/sys/devices/system/cpu/cpu*    cpufreq/scaling_min_freq    0660    system    system
/sys/devices/system/cpu/cpu*    cpufreq/scaling_max_freq    0660    system    system
/sys/devices/platform/soc/soc:qcom,cpu-cpu-ddr-bw/devfreq/*    min_freq          0664    system    system
/sys/devices/platform/soc/soc:qcom,cpu-cpu-ddr-bw/devfreq/*/bw_hwmon    *        0664    system    system
/sys/devices/platform/soc/soc:qcom,cpu*-cpu-ddr-lat*/devfreq/*    min_freq       0664    system    system
/sys/devices/platform/soc/*.qcom,cpu*-cpu-l3-lat/devfreq/*    min_freq           0664    system    system
