# Charger
/sys/class/oplus_chg/*  mmi_charging_enable    0660    system  system

# NFC
/dev/pn553    0660    nfc               nfc

# Reserve
/dev/block/bootdevice/by-name/oplusreserve2    0660    root    system

# WiFi
firmware_directories /odm/etc/wifi/

/sys/devices/system/cpu/cpufreq/policy0/schedutil    up_rate_limit_us    0660    system    system
/sys/devices/system/cpu/cpufreq/policy0/schedutil    down_rate_limit_us  0660    system    system
/sys/devices/system/cpu/cpufreq/policy0/schedutil    hispeed_load        0660    system    system
/sys/devices/system/cpu/cpufreq/policy0/schedutil    hispeed_freq        0660    system    system
/sys/devices/system/cpu/cpufreq/policy0/schedutil    rtg_boost_freq      0660    system    system
/sys/devices/system/cpu/cpufreq/policy0/schedutil    pl                  0660    system    system
/sys/devices/system/cpu/cpufreq/policy6/schedutil    up_rate_limit_us    0660    system    system
/sys/devices/system/cpu/cpufreq/policy6/schedutil    down_rate_limit_us  0660    system    system
/sys/devices/system/cpu/cpufreq/policy6/schedutil    hispeed_load        0660    system    system
/sys/devices/system/cpu/cpufreq/policy6/schedutil    hispeed_freq        0660    system    system
/sys/devices/system/cpu/cpufreq/policy6/schedutil    rtg_boost_freq      0660    system    system
/sys/devices/system/cpu/cpufreq/policy6/schedutil    pl                  0660    system    system

/sys/devices/system/cpu/cpufreq/policy0    scaling_governor    0660    system    system
/sys/devices/system/cpu/cpufreq/policy6    scaling_governor    0660    system    system
/sys/devices/system/cpu/cpufreq/policy0    scaling_min_freq    0660    system    system
/sys/devices/system/cpu/cpufreq/policy0    scaling_max_freq    0660    system    system
/sys/devices/system/cpu/cpufreq/policy6    scaling_min_freq    0660    system    system
/sys/devices/system/cpu/cpufreq/policy6    scaling_max_freq    0660    system    system
